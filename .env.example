# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
#   cp .env.example .env
# Then load it in your shell, e.g.:  set -a; source .env; set +a

# Groq — used for LLaMA 3.1 8B (summaries) and Kimi K2 (audit reasoning)
GROQ_API_KEY=your_groq_api_key
# Optional alias kept for compatibility with the original notebooks
# GROK_API_KEY=your_groq_api_key

# Google AI Studio — Gemini embeddings for policy retrieval
GEMINI_API_KEY=your_gemini_api_key

# Hugging Face — only needed to download datasets or push/pull models (training)
# HF_TOKEN=your_hf_token

# Optional overrides
# AUDITIX_CLASSIFIER_PATH=models/policy_classifier
# AUDITIX_INDEX_DIR=models/policy_index
# AUDITIX_POLICIES_PATH=policies/policies.txt
# AUDITIX_EXPLAIN_FAST_PATH=1
